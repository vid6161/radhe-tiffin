# Required production security
RADHE_SECRET_KEY=generate-a-long-random-secret
RADHE_ADMIN_USERNAME=admin
RADHE_ADMIN_PASSWORD=change-this-immediately

# Set this after Render gives you the final HTTPS URL.
PUBLIC_BASE_URL=https://YOUR-RENDER-URL

# Persistent Render disk
RADHE_DATABASE_PATH=/var/data/database.db
RADHE_EXCEL_PATH=/var/data/RadheTiffin_Business.xlsx

# Bank transfer details
RADHE_BANK_ACCOUNT_HOLDER=YOUR_ACCOUNT_HOLDER
RADHE_BANK_IBAN=YOUR_IBAN
RADHE_BANK_BIC=YOUR_BIC

# Optional card payments — leave unset until intentionally enabled.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
