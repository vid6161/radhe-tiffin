# Required for production
RADHE_SECRET_KEY=generate-a-long-random-secret
RADHE_ADMIN_USERNAME=admin
RADHE_ADMIN_PASSWORD=change-this-immediately

# Production URL, e.g. https://www.radhetiffin.de
PUBLIC_BASE_URL=https://YOUR-DOMAIN

# SQLite path on a persistent Render disk
RADHE_DATABASE_PATH=/var/data/database.db

# Optional: enable secure online card checkout
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Bank transfer details shown to customers
RADHE_BANK_ACCOUNT_HOLDER=YOUR_BUSINESS_NAME
RADHE_BANK_IBAN=DE00 0000 0000 0000 0000 00
RADHE_BANK_BIC=YOURBICXXX
